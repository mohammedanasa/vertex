# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-27"

# Server-only, read-only (Viewer) token — create at manage.sanity.io.
# Never expose this as a NEXT_PUBLIC_ variable.
SANITY_API_READ_TOKEN=

# Server-only write (Editor) token — used ONLY by the offline video ingestion
# script (scripts/ingest-videos.mjs), never by app code and never in the request
# path. Never expose this as a NEXT_PUBLIC_ variable.
SANITY_API_WRITE_TOKEN=

# Sanity Context MCP (search). Optional: defaults to the base URL built from the
# project id and dataset above. Set SANITY_CONTEXT_SLUG once the agent context
# document (sanity/context/vertex-search.json) is imported, or set the full URL.
SANITY_CONTEXT_SLUG=
SANITY_CONTEXT_MCP_URL=

# Groq inference (groq.com) — powers search ranking. Server-only, never exposed
# to the browser. Note: this is the LLM provider, not GROQ the Sanity query
# language.
GROQ_API_KEY=
# Optional override for the search model.
GROQ_SEARCH_MODEL=

# OpenRouter — automatic fallback when Groq is rate-limited or out of capacity.
# Optional: without it, search runs on Groq alone and fails when Groq is capped.
# Server-only, never exposed to the browser.
OPENROUTER_API_KEY=
# Optional comma-separated override of the free fallback models, in order.
OPENROUTER_SEARCH_MODELS=
